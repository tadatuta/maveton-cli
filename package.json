{
  "name": "maveton-cli",
  "version": "1.0.0",
  "description": "Создание и локальная валидация RSS подкастов с Podcasting 2.0",
  "type": "module",
  "bin": {
    "maveton": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint .",
    "test": "npm run build && node --test test/*.test.mjs",
    "docs": "npm run build && node scripts/generate-reference.mjs",
    "check": "npm run lint && npm test && node scripts/generate-reference.mjs --check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "saxes": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
